{
  "name": "wonderwp/logging",
  "description": "WonderWp Logging Component",
  "type": "library",
  "keywords": [
    "log",
    "logging",
    "WonderWp",
    "WordPress"
  ],
  "homepage": "https://github.com/wonderwp/Logging",
  "license": "MIT",
  "authors": [
    {
      "name": "Jeremy Desvaux",
      "homepage": "https://jdmweb.com"
    },
    {
      "name": "WonderWp Community",
      "homepage": "http://wonderwp.net/Contribution/Contributors.html"
    }
  ],
  "require": {
    "php": "^8.3"
  },
  "autoload": {
    "psr-4": {
      "WonderWp\\Component\\Logging\\": "src"
    },
    "exclude-from-classmap": [
      "/Tests/"
    ]
  },
  "minimum-stability": "dev",
  "require-dev": {
    "phpunit/phpunit": "^12.0"
  },
  "autoload-dev": {
    "psr-4": {
      "WonderWp\\Component\\Logging\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit --configuration phpunit.xml.dist"
  }
}
